---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thank you | Dodo & Co." description="Thanks for reaching out to Dodo & Co." current="start">
  <section><div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;max-width:640px">
    <img src="/img/logo.jpg" alt="" width="110" height="110" style="border-radius:50%;box-shadow:0 0 0 6px var(--paper),0 10px 40px var(--glow)">
    <span class="eyebrow">Merci!</span>
    <h1 style="font-size:clamp(38px,5.4vw,58px)">Thank you, I can't wait to <em class="soft">meet you</em>.</h1>
    <p class="lede">Alexa will reach out soon, usually within a day or two, to set up your free intro call. In the meantime, come say hi on Instagram.</p>
    <div class="ctas" style="justify-content:center"><a class="btn primary" href="https://www.instagram.com/dodocosleep/" target="_blank" rel="noopener">Instagram @dodocosleep</a><a class="btn ghost" href="/">Back to home</a></div>
  </div></section>
</Layout>
