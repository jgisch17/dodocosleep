---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found | Dodo & Co." description="This page drifted off to sleep." current="">
  <section><div class="wrap" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;max-width:640px">
    <img src="/img/logo.jpg" alt="" width="110" height="110" style="border-radius:50%">
    <h1 style="font-size:clamp(38px,5.4vw,58px)">This page went <em class="soft">night-night</em>.</h1>
    <p class="lede">We couldn't find what you were looking for.</p>
    <div class="ctas" style="justify-content:center"><a class="btn primary" href="/">Back to home</a></div>
  </div></section>
</Layout>
