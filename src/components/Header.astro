---
interface Props { current?: string }
const { current = 'home' } = Astro.props;
const links = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'about', href: '/about', label: 'About Alexa' },
  { key: 'support', href: '/sleep-support', label: 'Sleep support' },
  { key: 'start', href: '/get-started', label: 'Get started' },
];
---
<header class="nav"><div class="wrap">
  <a class="brand" href="/"><img src="/img/logo.jpg" alt="" width="44" height="44"><span><b>Dodo &amp; Co.</b><small>Faire dodo</small></span></a>
  <nav class="links" aria-label="Main">
    {links.map((l) => <a href={l.href} aria-current={l.key === current ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <a class="btn primary sm" href="/get-started">Book a free call</a>
</div></header>
